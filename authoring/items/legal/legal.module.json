{
  "$schema": "../../../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "legal-scs",
  "items": {
    "path": "serialized-content",
    "includes": [
      {
        "name": "renderings",
        "path": "/sitecore/Layout/Renderings/Project/legal",
        "allowedPushOperations": "CreateAndUpdate",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "home-templates",
        "path": "/sitecore/templates/Project/legal/Home Templates",
        "allowedPushOperations": "CreateAndUpdate",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "person-templates",
        "path": "/sitecore/templates/Project/legal/Person Templates",
        "allowedPushOperations": "CreateAndUpdate",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "article-templates",
        "path": "/sitecore/templates/Project/legal/Article Templates",
        "allowedPushOperations": "CreateAndUpdate",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "article-page-template",
        "path": "/sitecore/templates/Project/legal/ArticlePage",
        "allowedPushOperations": "CreateAndUpdate",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "person-page-template",
        "path": "/sitecore/templates/Project/legal/PersonPage",
        "allowedPushOperations": "CreateAndUpdate",
        "scope": "ItemAndDescendants"
      },
      {
        "name": "collection",
        "path": "/sitecore/content/legal/",
        "allowedPushOperations": "CreateAndUpdate",
        "scope": "SingleItem"
      },
      {
        "name": "legal",
        "path": "/sitecore/content/legal/legal",
        "allowedPushOperations": "CreateAndUpdate",
        "rules": [
          {
            "path": "/home",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Media",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Data",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Dictionary",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Presentation",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Settings/Site Grouping",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Settings",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "*",
            "scope": "Ignored"
          }
        ]
      }
    ]
  }
}
